{
  "path": "$HOUDINI_PACKAGE_PATH/..",
  "env": [
      {
        "HTG_BASEDIR": "$HOUDINI_PACKAGE_PATH/.."
      },
      {
        "HTG_REPO_NAME": "Baldrax/Houdini_TaleSpire_Terrain_Generation_Toolset"
      },
      {
        "HOUDINI_UI_QUEUE_SIZE": 300000
      },
      {
        "HOUDINI_OTLSCAN_PATH": {"houdini_version >= '21.0'": "$HTG_BASEDIR/recipes"}
      },
      {
        "PYTHONPATH": "$HTG_BASEDIR/python_libs"
      },
      {
        "CRYPTOGRAPHY_OPENSSL_NO_LEGACY": 1
      }
    ]
}